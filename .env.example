# Server & Auth
PORT=3000
NODE_ENV=development
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# ALLOW_PASSWORD_LOGIN=1 # local development only, when GOOGLE_CLIENT_ID is empty
MAX_STUDENTS=30

# Neon Postgres
DATABASE_URL=postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Object Storage (S3-compatible)
S3_ENDPOINT=https://your-storage-endpoint.neon.tech
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_PUBLIC=public-media
S3_BUCKET_PRIVATE=private-files
PUBLIC_FILE_BASE_URL=https://your-public-media-url.example.com
